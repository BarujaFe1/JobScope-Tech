# JobScope Tech BR — environment example
# Copy to `.env` for local overrides. Never commit real secrets.

# Backend
JOBSCOPE_ENV=development
JOBSCOPE_DEMO_MODE=true
# SQLite (default, zero-friction demo)
DATABASE_URL=sqlite:///./data/jobscope.db
# PostgreSQL (optional — use with docker compose)
# DATABASE_URL=postgresql+psycopg://jobscope:jobscope@localhost:5432/jobscope
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
